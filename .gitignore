# ==============================================================================
# AetherGrid .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Local Secrets
# ------------------------------------------------------------------------------
.env
.env.*
.env*.local
*.env
*.local
# Whitelist example configurations
!.env.example
!.env.sample

# Credentials & Private Keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_ecdsa
id_ed25519
secrets/

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
*/.venv/
*/venv/
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python testing & linting caches
.pytest_cache/
*/.pytest_cache/
.mypy_cache/
*/.mypy_cache/
.ruff_cache/
*/.ruff_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# ------------------------------------------------------------------------------
# Node.js, Frontend & Build Outputs
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend distribution & build artifacts
frontend/dist/
dist/
out/
.next/
*.tsbuildinfo
frontend/*.tsbuildinfo

# Tool & bundler caches
.eslintcache
.stylelintcache
.vite/
frontend/.vite/

# ------------------------------------------------------------------------------
# IDE, Editor & OS Files
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# Artifacts, Test Logs, Screenshots & Temporary Files
# ------------------------------------------------------------------------------
artifacts/screenshots/
artifacts/*.png
artifacts/*.jpg
*.log
logs/
*.tmp
*.temp
scratch/

# V0 / Vercel Sandbox files
.vercel/
.snowflake/
.design-cache/
.v0-trash/
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts