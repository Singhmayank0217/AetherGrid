# AetherGrid Environment Configuration Example

# Frontend Configuration
# URL of the backend FastAPI service accessible from client browser
VITE_API_BASE_URL=http://localhost:8000

# Backend Configuration
# Port for FastAPI application (default: 8000)
BACKEND_PORT=8000

# Frontend Port when running via Docker or local dev (default: 3000 / 5173)
FRONTEND_PORT=3000

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Day-Ahead Decision Cutoff Hour on D-1 in UTC (default: 23)
CUTOFF_HOUR=23
